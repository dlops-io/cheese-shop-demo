FROM python:3.13-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/home/app/.venv \
    UV_LINK_MODE=copy \
    PATH="/home/app/.venv/bin:$PATH"

RUN pip install --no-cache-dir uv==0.13.6 && \
    useradd -ms /bin/bash app -d /home/app -u 1000

USER app
WORKDIR /app

# The uv cache is a named volume (see docker-shell.sh); creating the directory here makes the
# volume start out owned by `app`, so each new container syncs from the cache instead of the network.
RUN mkdir -p /home/app/.cache/uv

COPY --chown=app:app . ./

ENTRYPOINT ["/bin/bash", "docker-entrypoint.dev.sh"]
